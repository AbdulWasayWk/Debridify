# Required for debrid streaming. Get it from https://torbox.app/settings
TORBOX_API_KEY=

# Server
PORT=7000
# URL Stremio uses to reach this addon. Use your LAN IP (e.g. http://192.168.1.20:7000) for TVs/phones.
# BASE_URL=http://127.0.0.1:7000

# Search tuning
PROVIDER_TIMEOUT_MS=7000
# DISABLED_PROVIDERS=torrentscsv,subsplease

# Optional extra sources (Torznab)
# JACKETT_URL=http://localhost:9117/api/v2.0
# JACKETT_API_KEY=
# PROWLARR_URL=http://localhost:9696
# PROWLARR_API_KEY=

LOG_LEVEL=info
# LOG_PRETTY=false
