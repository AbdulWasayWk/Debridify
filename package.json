{
	"name": "debridify",
	"version": "2.0.0",
	"description": "Local Stremio addon: live torrent search (movies, series, anime) streamed through TorBox",
	"type": "module",
	"main": "dist/index.js",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "tsx watch --clear-screen=false src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start:prod": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "node --import tsx --test test/*.test.ts",
		"smoke": "tsx scripts/smoke.ts",
		"format": "prettier --write src test scripts"
	},
	"dependencies": {
		"@viren070/parse-torrent-title": "^0.9.2",
		"dotenv": "^17.2.3",
		"express": "^5.1.0",
		"fast-xml-parser": "^5.3.2",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.2"
	},
	"devDependencies": {
		"@types/express": "^5.0.5",
		"@types/node": "^24.10.1",
		"prettier": "3.7.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
